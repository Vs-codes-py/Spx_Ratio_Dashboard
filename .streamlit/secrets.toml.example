# Copy this file to `.streamlit/secrets.toml` for LOCAL development.
# `.streamlit/secrets.toml` is git-ignored and must NEVER be committed.
#
# On Streamlit Community Cloud you do NOT upload this file. Instead paste the
# same key = value lines into:  App  ->  Settings  ->  Secrets
# Streamlit stores those encrypted at rest and injects them at runtime; they
# are never visible in the repo or to app viewers.

DATABENTO_API_KEY = "your-databento-key-here"
TWELVE_DATA_API_KEY = "your-twelve-data-key-here"
